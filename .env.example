# Capital.com API (server-side only, never exposed to the browser)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
# "demo" (default) or "live"
CAPITAL_ENV=demo

# Single password protecting the whole dashboard (pages + API)
DASHBOARD_PASSWORD=

# Optional: external ML forecast service (see forecast-service/README.md).
# URL of its endpoint, e.g. https://my-forecast.vercel.app/api/forecast
FORECAST_SERVICE_URL=
# Shared secret sent as "Authorization: Bearer ..." (must be identical in the service)
FORECAST_SERVICE_TOKEN=

# Journal des prévisions (stockage Vercel Blob privé).
# BLOB_READ_WRITE_TOKEN est ajouté automatiquement quand un stockage Blob est relié au projet Vercel.
BLOB_READ_WRITE_TOKEN=
# Secret du relevé quotidien (Vercel Cron l'envoie en "Authorization: Bearer ..."). Sans lui, la route refuse tout.
CRON_SECRET=

# Alertes sur téléphone (ntfy). NTFY_TOPIC = nom long et aléatoire du sujet (sert de mot de passe).
NTFY_TOPIC=

# Ordres sur compte DÉMO uniquement. Laisser vide = aucun ordre possible. Mettre "true" pour activer (CAPITAL_ENV doit rester "demo").
TRADING_ENABLED=
