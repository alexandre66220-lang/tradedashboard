# Capital.com API (server-side only, never exposed to the browser)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
# "demo" (default) or "live"
CAPITAL_ENV=demo

# Single password protecting the whole dashboard (pages + API)
DASHBOARD_PASSWORD=

# Optional: external ML forecast service (see forecast-service/README.md).
# URL of its endpoint, e.g. https://my-forecast.vercel.app/api/forecast
FORECAST_SERVICE_URL=
# Shared secret sent as "Authorization: Bearer ..." (must be identical in the service)
FORECAST_SERVICE_TOKEN=
