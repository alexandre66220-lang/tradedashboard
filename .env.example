# Capital.com API (server-side only, never exposed to the browser)
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_API_PASSWORD=
# "demo" (default) or "live"
CAPITAL_ENV=demo

# Single password protecting the whole dashboard (pages + API)
DASHBOARD_PASSWORD=

# Optional: external forecast service (same JSON format as /api/forecast)
FORECAST_SERVICE_URL=
